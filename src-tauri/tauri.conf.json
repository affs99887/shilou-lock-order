{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "拾漏锁单",
  "version": "0.6.3-community.2",
  "identifier": "local.apple-pickup-watcher.auto",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "拾漏锁单",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/apw-checkout",
      "resources/OpenSource/*"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "active": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5RUEzQjk5MUVCQkE5MjQKUldRa3Fic2VtVHZxV2FYUFVvVmtoTG15TjlBbzVXRy9FREFGNmlXN1BwN25MS1JxenhzR2NIVVoK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
